  "oracle_contract": {
    "validity_mask": "all existing ball detector calls; bypasses visibility/occlusion",
    "covariance_m2": "I * 1e-12",
    "timestamp": "current plant time must equal frame capture time within 1e-8 s",
    "position_source": "football freejoint qpos current center, world survey frame",
