  "methods": [
    "current",
    "earlier",
    "exact_ball_diagnostic"
  ],
  "method_definitions": {
    "current": "Latest form-oriented sensor catch controller frozen before batch.",
    "earlier": "Route-specific previous sensor controller; method bundle comparison when multiple parameters differ.",
    "exact_ball_diagnostic": "Current controller with exact current ball center at every existing detector call, including invisible/occluded frames, covariance=identity*1e-12 m2. Capture cadence and fitted-velocity tracker unchanged; removes position error, visibility loss and position uncertainty together. No exact velocity, contact, future state or receiver pose. New privileged observation diagnostic, not historical, deployable or a guaranteed upper bound."
  },
  "throw_perturbation": {
    "lateral_basis": "Fixed per-route surveyed lateral vector declared in route manifest, same across methods.",
    "mutate_only": [
      "play.quarterback_target_m horizontal lateral offset",
      "play.quarterback_target_m vertical offset",
      "play.release_s offset"
    ],
    "fixed": [
      "machine origin",
      "receiver start",
      "catch plane",
      "approach axis",
      "cameras",
      "controller",
      "nominal route"
    ],
    "commanded_release_event_visible": true,
    "release_adapter": "If route uses commanded event-relative release delay, add identical release_s offset to that delay and declare mapping. Do not change measured route event."
  },
