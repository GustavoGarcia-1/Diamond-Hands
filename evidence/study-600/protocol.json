    "minimum_ball_contact_distance_m"
  ],
  "analysis": {
    "interval": "Wilson 95%",
    "denominator": 50,
    "show_counts": true,
    "paired_differences": true,
    "retain_failures": true,
    "never_select_best_subset": true,
    "exact_ball_not_guaranteed_upper_bound": true
  },
  "execution": {
    "max_workers_per_route": 2,
    "per_trial_timeout_s": 180,
    "immutable_source_snapshot": true,
    "keep_all_traces": true,
    "retries": "Infrastructure only, same inputs/seed/source; preserve failed receipt. No resampling.",
    "no_tuning_against_batch": true,
    "route_manifest_required": [
      "profiles and hashes",
      "source archive hash",
      "structured command",
      "exact model identity",
      "lateral basis",
      "method changes",
      "50 fixed scenario hash"
    ]
